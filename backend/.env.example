# HomeHub Backend Environment Example
# Copy this file to .env for local development.
# Do not commit real secret values.

# Runtime environment: local, staging, or production
APP_ENV=local
NODE_ENV=development

# API bind settings
HOST=0.0.0.0
PORT=4000

# Public URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret

# Database connection string for server-side migrations or direct backend access when introduced.
# Do not use this until database access is intentionally implemented.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# AWS S3 document storage placeholders. Do not use until AWS integration is intentionally implemented.
AWS_REGION=us-east-1
S3_DOCUMENT_BUCKET=homehub-documents-local
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key

# Stripe placeholders. Use test keys locally and in staging. Do not use until Stripe integration is intentionally implemented.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
