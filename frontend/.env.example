# HomeHub Frontend Environment Example
# Copy this file to .env.local for local development.
# Do not commit real secret values.

# Runtime environment: local, staging, or production
NEXT_PUBLIC_APP_ENV=local

# Public application URL used by the browser
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public API base URL used by the frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase public project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anon key. This key is safe to expose to the browser when Row Level Security and backend authorization are configured correctly.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Stripe publishable key. Use pk_test_* locally and in staging; use pk_live_* only in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional browser/client observability setting
NEXT_PUBLIC_LOG_LEVEL=info
